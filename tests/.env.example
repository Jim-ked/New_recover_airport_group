# Copy to .env only if your host process loads dotenv; otherwise set these as OS/service
# environment variables.  The application itself does not auto-load .env files.

# Required before `python -m backend serve`. Generate a unique random value >= 32 chars.
AIRPORT_GROUP_SECRET_KEY=

# Network. Keep 127.0.0.1 when accessed through a local/reverse proxy; use 0.0.0.0 only
# when the machine must accept LAN connections directly.
AIRPORT_GROUP_HOST=127.0.0.1
AIRPORT_GROUP_PORT=8080
AIRPORT_GROUP_DEBUG=false

# Runtime locations. Relative paths resolve under the project root.
AIRPORT_GROUP_RUNTIME_ROOT=runtime
# AIRPORT_GROUP_DB_PATH=runtime/db/airport_group.sqlite3
# AIRPORT_GROUP_CONTENT_DIR=runtime/content
# AIRPORT_GROUP_RUN_DIR=runtime/runs
# AIRPORT_GROUP_LOG_DIR=runtime/logs
# AIRPORT_GROUP_TEMP_DIR=runtime/temp
# AIRPORT_GROUP_TILE_ROOT=resources/tiles

# Session policy: 30 minutes idle, 8 hours absolute by default.
AIRPORT_GROUP_SESSION_IDLE_SECONDS=1800
AIRPORT_GROUP_SESSION_ABSOLUTE_SECONDS=28800
AIRPORT_GROUP_SESSION_COOKIE_SECURE=false

# Optional local/offline tile template injected into Situation/GIS runtime pages.
# Example after local assets are prepared: /tiles/{z}/{x}/{y}.png
AIRPORT_GROUP_GIS_TILE_TEMPLATE=

# Initial administrator. Used only while the user table is empty. Prefer interactive
# `python -m backend init` so the password does not need to remain in an environment file.
# AIRPORT_GROUP_BOOTSTRAP_ADMIN_LOGIN=admin
# AIRPORT_GROUP_BOOTSTRAP_ADMIN_PASSWORD=
# AIRPORT_GROUP_BOOTSTRAP_ADMIN_USER_ID=admin

AIRPORT_GROUP_MAX_CONTENT_LENGTH_BYTES=52428800
AIRPORT_GROUP_LOG_LEVEL=INFO
AIRPORT_GROUP_SERVER_THREADS=8